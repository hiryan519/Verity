# Copy to a local environment file or set these variables in the shell.
# Never commit a real API key.
VERITY_LLM_PROVIDER=zhipu

# Use one provider key; do not paste it into the repository.
# ZHIPUAI_API_KEY=
# OPENAI_API_KEY=
# VERITY_LLM_API_KEY=

# Route experts by model tier. Exact model IDs depend on the provider account.
VERITY_LLM_MODEL_REASONING=
VERITY_LLM_MODEL_FAST=

# Optional overrides.
# VERITY_LLM_MODEL=
# VERITY_LLM_BASE_URL=
# VERITY_LLM_TIMEOUT_SECONDS=90
# VERITY_LLM_MAX_TOKENS=3000

# Public web evidence collection. Keep the real key only in apps/api/.env.
# TAVILY_API_KEY=
